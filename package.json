{
  "name": "steel-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Steel Browser API - provides tools for web scraping and browser automation",
  "main": "src/mcp-handler.js",
  "type": "module",
  "scripts": {
    "build:edge": "esbuild src/mcp-handler.js --bundle --format=esm --platform=browser --target=es2022 --outfile=edge-functions/mcp/index.js",
    "start": "node local-server.js",
    "dev": "node local-server.js"
  },
  "keywords": [
    "mcp",
    "steel",
    "browser",
    "automation",
    "scraping"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
